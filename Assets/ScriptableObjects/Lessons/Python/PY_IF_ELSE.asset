  m_Script: {fileID: 11500000, guid: 42a7ef911f4c60e408989a759d2b9b18, type: 3}
  m_Name: PY_IF_ELSE
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Programming.LessonData
  id: PY_IF_ELSE
  language: 1
  conceptTitle: 'Conditions: if and else'
  symbol: if
  relatedQuestionIds:
  - PY_05_IF_ELSE
  - HZ_PY_02_IF_ELSE
  topics:
  - If / Else
  definition: 'An if statement lets a program make a decision: it runs some code
    only when a condition is True.'
  howItWorks: 'Write if, then a condition, then a colon (:). The lines that belong
    to the if are indented (moved to the right). An optional else: block runs when
    the condition is False. Only one of the two blocks runs.'
  exampleCode: "temperature = 30\nif temperature > 25:\n    print(\"Wear a hat\")\nelse:\n   
    print(\"Bring a jacket\")"
  exampleExplanation: 30 > 25 is True, so the indented line under if runs and the
    program prints Wear a hat. The else block is skipped. If temperature were 18,
    it would print Bring a jacket instead.
  tip: 'Indentation matters in Python: it shows which lines belong to the if and
    which belong to the else.'
