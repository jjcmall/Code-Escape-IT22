  m_Script: {fileID: 11500000, guid: 1833b97b4e8284e489c3555d5dace838, type: 3}
  m_Name: PHP_TYPE_08_FUNCTIONS
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Programming.QuestionData
  id: PHP_TYPE_08_FUNCTIONS
  language: 2
  topic: Functions
  difficulty: 1
  questionType: 2
  questionText: Type the expression the function should return so it doubles its
    input.
  code: "<?php\nfunction double($n) {\n    return ____;\n}\necho double(4);"
  answerFormat: 1
  choices: []
  correctChoiceIndex: 0
  monospaceChoices: 0
  acceptedAnswers:
  - $n * 2
  - 2 * $n
  - $n + $n
  caseSensitive: 1
  referenceFill: 
  runTests: []
  explanation: return sends a value back to the caller. $n * 2 uses the parameter,
    so double(4) returns 8, which echo prints.
  hint: Use the parameter $n and an operator to make it twice as large.
  wrongChoiceFeedback: []
  wrongAnswerFeedback: Use the parameter $n (with its dollar sign) in your answer,
    not a fixed number.
