  m_Name: PHP_01_VARIABLES
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Programming.QuestionData
  id: PHP_01_VARIABLES
  language: 2
  topic: Variables
  difficulty: 0
  questionType: 3
  questionText: This PHP code causes an error on line 2. Type the corrected line
    2.
  code: '<?php

    name = "Alex";

    echo $name;

    ?>'
  answerFormat: 1
  choices: []
  correctChoiceIndex: 0
  monospaceChoices: 0
  acceptedAnswers:
  - $name = "Alex";
  - $name = 'Alex';
  caseSensitive: 1
  referenceFill: 
  runTests: []
  explanation: Every PHP variable starts with a dollar sign. name = "Alex"; is not
    valid PHP, but  $name = "Alex";  is, and then echo $name outputs Alex.
  hint: Compare how the variable is written on the two lines.
  wrongChoiceFeedback: []
  wrongAnswerFeedback: Compare how the variable is written on line 2 and line 3.
    Keep the same value and the semicolon.
