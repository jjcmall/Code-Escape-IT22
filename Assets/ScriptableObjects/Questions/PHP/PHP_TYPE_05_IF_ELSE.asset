  m_Script: {fileID: 11500000, guid: 1833b97b4e8284e489c3555d5dace838, type: 3}
  m_Name: PHP_TYPE_05_IF_ELSE
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Programming.QuestionData
  id: PHP_TYPE_05_IF_ELSE
  language: 2
  topic: If / Else
  difficulty: 0
  questionType: 2
  questionText: Type the comparison operator so the message is shown for ages 13
    and older.
  code: "<?php\n$age = 13;\nif ($age ____ 13) {\n    echo \"Allowed\";\n}"
  answerFormat: 1
  choices: []
  correctChoiceIndex: 0
  monospaceChoices: 0
  acceptedAnswers:
  - '>='
  caseSensitive: 1
  referenceFill: 
  runTests: []
  explanation: '>= means greater than or equal to, so it is true for 13 and anything
    older. > alone would leave out exactly 13.'
  hint: The age 13 itself must be allowed, not only older ages.
  wrongChoiceFeedback: []
  wrongAnswerFeedback: 'Check the edge: age 13 must give Allowed. One comparison
    operator includes the value itself.'
