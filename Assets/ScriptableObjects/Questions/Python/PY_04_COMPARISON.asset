  m_Script: {fileID: 11500000, guid: 1833b97b4e8284e489c3555d5dace838, type: 3}
  m_Name: PY_04_COMPARISON
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Programming.QuestionData
  id: PY_04_COMPARISON
  language: 1
  topic: Comparison
  difficulty: 0
  questionType: 2
  questionText: The door opens only when code equals 1234. Fill in the comparison
    operator.
  code: "if code ____ 1234:\n    print(\"Open\")\nelse:\n    print(\"Locked\")"
  answerFormat: 2
  choices: []
  correctChoiceIndex: 0
  monospaceChoices: 0
  acceptedAnswers: []
  caseSensitive: 1
  referenceFill: ==
  runTests:
  - setup: code = 1234
    expectedOutput: Open
  - setup: code = 1000
    expectedOutput: Locked
  - setup: code = 1300
    expectedOutput: Locked
  explanation: == compares two values. A single = assigns a value and is a SyntaxError
    inside an if. Python has no === operator, and "less than or equal" is written
    <=, not =<.
  hint: One equals sign stores a value. Which operator compares?
  wrongChoiceFeedback: []
  wrongAnswerFeedback: The door must open for 1234 only, not for bigger or smaller
    codes. One equals sign stores a value; a different operator compares.
