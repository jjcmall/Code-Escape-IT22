  m_Name: PY_RUN_13_FUNCTIONS_GREET
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Programming.QuestionData
  id: PY_RUN_13_FUNCTIONS_GREET
  language: 1
  topic: Functions
  difficulty: 1
  questionType: 2
  questionText: Fill in the value the function should return so greet("Sam") gives
    Hello Sam.
  code: "def greet(name):\n    return ____\n\nprint(greet(person))"
  answerFormat: 2
  choices: []
  correctChoiceIndex: 0
  monospaceChoices: 0
  acceptedAnswers: []
  caseSensitive: 1
  referenceFill: '"Hello " + name'
  runTests:
  - setup: person = "Sam"
    expectedOutput: Hello Sam
  - setup: person = "Alex"
    expectedOutput: Hello Alex
  explanation: + joins two pieces of text. "Hello " + name uses the parameter, so
    the function returns Hello Sam for Sam and Hello Alex for Alex.
  hint: Join the text "Hello " (with a space at the end) and the parameter name.
  wrongChoiceFeedback: []
  wrongAnswerFeedback: Use the parameter name (not a fixed name) and join it to the
    greeting text with +. Don't forget the space after Hello.
