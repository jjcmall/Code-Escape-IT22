  m_Script: {fileID: 11500000, guid: 1833b97b4e8284e489c3555d5dace838, type: 3}
  m_Name: PY_RUN_01_VARIABLES
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Programming.QuestionData
  id: PY_RUN_01_VARIABLES
  language: 1
  topic: Variables
  difficulty: 0
  questionType: 2
  questionText: The variable score already has a value. Fill in the blank so the
    program adds 5 to the score and prints the new score.
  code: '____

    print(score)'
  answerFormat: 2
  choices: []
  correctChoiceIndex: 0
  monospaceChoices: 0
  acceptedAnswers: []
  caseSensitive: 1
  referenceFill: score = score + 5
  runTests:
  - setup: score = 10
    expectedOutput: 15
  - setup: score = 4
    expectedOutput: 9
  - setup: score = 0
    expectedOutput: 5
  explanation: A variable can be reassigned using its own old value. score = score
    + 5 reads the current score, adds 5, and stores the result back in score, so
    it works whatever the starting score is.
  hint: The new value of score is the old score plus 5. Which variable holds the
    old score?
  wrongChoiceFeedback: []
  wrongAnswerFeedback: Use the variable score itself in your answer (not a fixed
    number) so it works for any starting score. Then check the code printed the new
    value.
