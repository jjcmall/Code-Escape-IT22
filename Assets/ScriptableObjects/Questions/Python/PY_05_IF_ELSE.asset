  m_Script: {fileID: 11500000, guid: 1833b97b4e8284e489c3555d5dace838, type: 3}
  m_Name: PY_05_IF_ELSE
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Programming.QuestionData
  id: PY_05_IF_ELSE
  language: 1
  topic: If / Else
  difficulty: 0
  questionType: 3
  questionText: The line  if battery < 20  causes a SyntaxError. Type the corrected
    line.
  code: "____\n    print(\"Low battery!\")\nelse:\n    print(\"Battery okay\")"
  answerFormat: 2
  choices: []
  correctChoiceIndex: 0
  monospaceChoices: 0
  acceptedAnswers: []
  caseSensitive: 1
  referenceFill: 'if battery < 20:'
  runTests:
  - setup: battery = 15
    expectedOutput: Low battery!
  - setup: battery = 25
    expectedOutput: Battery okay
  - setup: battery = 20
    expectedOutput: Battery okay
  explanation: 'In Python every if, elif and else line must end with a colon. The
    fixed line is  if battery < 20:  and the program then prints Low battery!'
  hint: 'Compare the if line with the else line. What does else: have that the if
    line is missing?'
  wrongChoiceFeedback: []
  wrongAnswerFeedback: 'Compare your line with the else: line. Keep the same condition,
    and check the end of the line.'
