  m_Script: {fileID: 11500000, guid: 1833b97b4e8284e489c3555d5dace838, type: 3}
  m_Name: SQL_02_WHERE
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Programming.QuestionData
  id: SQL_02_WHERE
  language: 3
  topic: WHERE
  difficulty: 0
  questionType: 4
  questionText: Type the full query that returns all columns of the sightings reported
    by Leo.
  code: 'Table: sightings

    +----+----------+-------+---------+

    | id | location
    | time  | witness |

    +----+----------+-------+---------+

    |  1 | Park    
    | 15:10 | Mia     |

    |  2 | Library  | 15:40 | Leo     |

    |  3 | Bus
    Stop | 16:05 | Ana     |

    |  4 | Arcade   | 15:25 | Leo     |

    +----+----------+-------+---------+'
  answerFormat: 1
  choices: []
  correctChoiceIndex: 0
  monospaceChoices: 0
  acceptedAnswers:
  - SELECT * FROM sightings WHERE witness = 'Leo';
  - SELECT * FROM sightings WHERE witness = "Leo";
  caseSensitive: 0
  referenceFill: 
  runTests: []
  explanation: WHERE filters rows and comes after FROM. Text values go in single
    quotes. SQL has no IF clause, and SELECT Leo would look for a column named Leo.
  hint: The filtering keyword goes after FROM table_name.
  wrongChoiceFeedback: []
  wrongAnswerFeedback: The pattern is SELECT columns FROM table WHERE condition.
    Text values go in single quotes.
