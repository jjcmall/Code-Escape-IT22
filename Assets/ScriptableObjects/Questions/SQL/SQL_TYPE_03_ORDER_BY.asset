  m_Script: {fileID: 11500000, guid: 1833b97b4e8284e489c3555d5dace838, type: 3}
  m_Name: SQL_TYPE_03_ORDER_BY
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Programming.QuestionData
  id: SQL_TYPE_03_ORDER_BY
  language: 3
  topic: ORDER BY
  difficulty: 1
  questionType: 2
  questionText: Type what goes after ORDER BY so the latest time comes first.
  code: 'Table: sightings

    +----+----------+-------+---------+

    | id | location
    | time  | witness |

    +----+----------+-------+---------+

    |  1 | Park    
    | 15:10 | Mia     |

    |  2 | Library  | 15:40 | Leo     |

    |  3 | Bus
    Stop | 16:05 | Ana     |

    |  4 | Arcade   | 15:25 | Leo     |

    +----+----------+-------+---------+


    SELECT
    location FROM sightings

    ORDER BY ____;'
  answerFormat: 1
  choices: []
  correctChoiceIndex: 0
  monospaceChoices: 0
  acceptedAnswers:
  - time DESC
  caseSensitive: 0
  referenceFill: 
  runTests: []
  explanation: ORDER BY sorts the rows. Adding DESC sorts from the largest to the
    smallest, so the latest time comes first.
  hint: Name the column to sort by, then add the word that means 'largest first'.
  wrongChoiceFeedback: []
  wrongAnswerFeedback: 'You need two parts: the column to sort by, and the word that
    reverses the order (largest first).'
