  m_Script: {fileID: 11500000, guid: 1833b97b4e8284e489c3555d5dace838, type: 3}
  m_Name: SQL_TYPE_04_AND_OR
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Programming.QuestionData
  id: SQL_TYPE_04_AND_OR
  language: 3
  topic: AND / OR
  difficulty: 1
  questionType: 2
  questionText: 'Type the word that makes both conditions have to be true: the witness
    is Leo and the time is after 15:30.'
  code: 'Table: sightings

    +----+----------+-------+---------+

    | id | location
    | time  | witness |

    +----+----------+-------+---------+

    |  1 | Park    
    | 15:10 | Mia     |

    |  2 | Library  | 15:40 | Leo     |

    |  3 | Bus
    Stop | 16:05 | Ana     |

    |  4 | Arcade   | 15:25 | Leo     |

    +----+----------+-------+---------+


    SELECT
    * FROM sightings

    WHERE witness = ''Leo'' ____ time > ''15:30'';'
  answerFormat: 1
  choices: []
  correctChoiceIndex: 0
  monospaceChoices: 0
  acceptedAnswers:
  - AND
  caseSensitive: 0
  referenceFill: 
  runTests: []
  explanation: AND keeps a row only when both conditions are true. Only Leo's 15:40
    sighting matches both, while OR would keep any row that matches either one.
  hint: Which word means both conditions must be true?
  wrongChoiceFeedback: []
  wrongAnswerFeedback: One keyword joins two conditions so that both must be true.
    OR would only need one of them.
