  m_Script: {fileID: 11500000, guid: 1833b97b4e8284e489c3555d5dace838, type: 3}
  m_Name: SQL_06_UPDATE
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Programming.QuestionData
  id: SQL_06_UPDATE
  language: 3
  topic: UPDATE
  difficulty: 1
  questionType: 3
  questionText: This query changes every row, but Alex wants to move ONLY the Map.
    Type the clause to add before the semicolon.
  code: 'Table: clues

    +----+----------+--------+

    | id | item     | room  
    |

    +----+----------+--------+

    |  1 | Backpack | Hall   |

    |  2 |
    Note     | Office |

    |  3 | Map      | Hall   |

    +----+----------+--------+


    UPDATE
    clues

    SET room = ''Garage'';'
  answerFormat: 1
  choices: []
  correctChoiceIndex: 0
  monospaceChoices: 0
  acceptedAnswers:
  - WHERE item = 'Map'
  - WHERE item = "Map"
  - WHERE id = 3
  caseSensitive: 0
  referenceFill: 
  runTests: []
  explanation: Without WHERE, UPDATE changes every row in the table. UPDATE clues
    SET room = 'Garage' WHERE item = 'Map'; changes only the Map row.
  hint: Which clause limits a query to certain rows?
  wrongChoiceFeedback: []
  wrongAnswerFeedback: One clause limits a query to certain rows. Use it to pick
    the row whose item is Map.
