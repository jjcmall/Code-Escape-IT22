  id: HZ_SQL_02_WHERE
  language: 3
  topic: WHERE
  difficulty: 0
  questionType: 1
  questionText: Which names does this query return? Type them, separated by commas.
  code: 'Table: badges

    +----+-------+------------+-------+

    | id | name 
    | department | level |

    +----+-------+------------+-------+

    |  1 | Rosa 
    | Security   |     3 |

    |  2 | Omar  | Lab        |     1 |

    |  3 | Kim  
    | Security   |     2 |

    |  4 | Tariq | Archive    |     1 |

    +----+-------+------------+-------+


    SELECT
    name FROM badges

    WHERE department = ''Security'';'
  answerFormat: 1
  choices: []
  correctChoiceIndex: 0
  monospaceChoices: 0
  acceptedAnswers:
  - Rosa, Kim
  - Rosa and Kim
  - Rosa Kim
  - Kim, Rosa
  - Kim and Rosa
  caseSensitive: 0
  referenceFill: 
  runTests: []
  explanation: 'WHERE keeps only the rows whose department is Security: Rosa (row
    1) and Kim (row 3).'
  hint: Look down the department column for Security.
  wrongChoiceFeedback: []
  wrongAnswerFeedback: Look down the department column for Security and type every
    matching name.
