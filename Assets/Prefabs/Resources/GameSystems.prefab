--- !u!114 &3008904315565549379
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8935516835678072354}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b8f5945b7d858434982f933781ec2710, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Story.StoryManager
  steps:
  - id: home_find_clue
    objective: Find the first clue.
    completeOnEvent: clue:C01_FOLLOW_THE_CODE
    unlockLevel: 
    cutsceneId: first_clue
  - id: home_message
    objective: Investigate the strange message.
    completeOnEvent: clue:C02_SENTINEL_SIGNAL
    unlockLevel: 04_Neighborhood
    cutsceneId: 
  - id: go_neighborhood
    objective: Follow the clue to the neighborhood.
    completeOnEvent: enter:04_Neighborhood
    unlockLevel: 
    cutsceneId: 
  - id: neighborhood_investigate
    objective: Investigate the neighborhood.
    completeOnEvent: clue:C03_DROPPED_BACKPACK
    unlockLevel: 
    cutsceneId: 
  - id: neighborhood_gate
    objective: Solve the gate's code lock.
    completeOnEvent: clue:C04_WAREHOUSE_ARROW
    unlockLevel: 05_Warehouse
    cutsceneId: 
  - id: go_warehouse
    objective: Follow the clue to the warehouse.
    completeOnEvent: enter:05_Warehouse
    unlockLevel: 
    cutsceneId: 
  - id: warehouse_investigate
    objective: Investigate the warehouse.
    completeOnEvent: clue:C05_SMALL_FOOTPRINTS
    unlockLevel: 
    cutsceneId: 
  - id: warehouse_security
    objective: Solve the security challenge.
    completeOnEvent: challenge:warehouse_security
    unlockLevel: 
    cutsceneId: 
  - id: warehouse_terminal
    objective: Search the computer terminal.
    completeOnEvent: clue:C06_HIDDEN_MESSAGE
    unlockLevel: 06_Facility
    cutsceneId: hidden_message
  - id: go_facility
    objective: Follow the hidden message.
    completeOnEvent: enter:06_Facility
    unlockLevel: 
    cutsceneId: 
  - id: facility_doors
    objective: Get through the facility's security doors.
    completeOnEvent: challenge:facility_door_b
    unlockLevel: 
    cutsceneId: 
  - id: facility_control
    objective: Search the control room.
    completeOnEvent: clue:C07_FACILITY_MAP
    unlockLevel: 07_Station
    cutsceneId: 
  - id: go_station
    objective: Find the old station.
    completeOnEvent: enter:07_Station
    unlockLevel: 
    cutsceneId: 
  - id: station_lock
    objective: Crack the station's code lock.
    completeOnEvent: clue:C08_FINAL_MESSAGE
    unlockLevel: 
    cutsceneId: old_station
  - id: station_route
    objective: Check SENTINEL's route display.
    completeOnEvent: event:station_route
    unlockLevel: 08_FinalArea
    cutsceneId: final_clue
  - id: go_final
    objective: Follow SENTINEL's final message.
    completeOnEvent: enter:08_FinalArea
    unlockLevel: 
    cutsceneId: 
  - id: final_security
    objective: Unlock the final security system.
    completeOnEvent: challenge:final_door
    unlockLevel: 
    cutsceneId: 
  - id: find_child
    objective: Find the missing child.
    completeOnEvent: event:child_found
    unlockLevel: 
    cutsceneId: ending
  - id: case_closed
    objective: Case closed. Your sibling is safe.
    completeOnEvent: 
    unlockLevel: 
    cutsceneId: 
  currentStepIndex: 0
--- !u!114 &4248506696736786529
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8935516835678072354}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7532d2c20f0dd0b40aab4882bebbc673, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CodeEscape.Game.LevelManager
  levels:
  - levelId: home
    sceneName: 03_Home
    displayName: "HOME \u2014 LIVING ROOM"
    mapDescription: A strange message is waiting on the family computer. Find the
      first clue.
    mapTagline: A strange message waits on the computer.
    mapPicture: {fileID: 21300000, guid: 6be204c44584821469de09928ae7a566, type: 3}
    unlockedAtStart: 1
    requiredChallenges:
    - home_hallway_door
  - levelId: neighborhood
    sceneName: 04_Neighborhood
    displayName: MAPLE STREET
    mapDescription: Follow the trail down Maple Street and open the gate's code lock.
    mapTagline: Follow Sam's trail down Maple Street.
    mapPicture: {fileID: 21300000, guid: a1a39b71f697fbf4bbe70afe793b7a85, type: 3}
    unlockedAtStart: 0
    requiredChallenges:
    - neighborhood_gate
  - levelId: warehouse
    sceneName: 05_Warehouse
    displayName: WAREHOUSE 7
    mapDescription: Search Warehouse 7 for footprints and get past its security system.
    mapTagline: Crates, footprints and a security bot.
    mapPicture: {fileID: 21300000, guid: 7f8942741c4d4644083e8bffdc380716, type: 3}
    unlockedAtStart: 0
    requiredChallenges:
    - warehouse_security
  - levelId: facility
    sceneName: 06_Facility
    displayName: RIVERSIDE TECH FACILITY
    mapDescription: Get through the facility's security doors and search the control
      room.
    mapTagline: Labs, lasers and locked blast doors.
    mapPicture: {fileID: 21300000, guid: 51b827f9115aaf249b86167ee0607a2b, type: 3}
    unlockedAtStart: 0
    requiredChallenges:
    - facility_door_a
    - facility_door_b
  - levelId: station
    sceneName: 07_Station
    displayName: OLD STATION
    mapDescription: Crack the old station's code lock and read SENTINEL's route display.
    mapTagline: An old platform hides SENTINEL's route.
    mapPicture: {fileID: 21300000, guid: 7a574487d41149348a6e181bdfeccabc, type: 3}
    unlockedAtStart: 0
    requiredChallenges:
    - station_lock
  - levelId: final_area
    sceneName: 08_FinalArea
    displayName: SENTINEL CONTROL ROOM
    mapDescription: Unlock SENTINEL's final security system and find your sibling,
      Sam.
    mapTagline: Reach SENTINEL's core and find Sam.
    mapPicture: {fileID: 21300000, guid: cdcd285688fd1e046b12592cb8ffb0ec, type: 3}
    unlockedAtStart: 0
    requiredChallenges:
    - final_lock_a
    - final_lock_b
    - final_door
  currentLevel: 03_Home
